FROM --platform=$BUILDPLATFORM golang:1.24-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY usage-service ./usage-service
WORKDIR /src/usage-service
RUN go mod download
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -o /out/limit-gate ./cmd/limit-gate

FROM alpine:3.21
RUN apk add --no-cache ca-certificates wget
WORKDIR /app
COPY --from=build /out/limit-gate /usr/local/bin/limit-gate
ENV LIMIT_GATE_LISTEN=0.0.0.0:8788
EXPOSE 8788
ENTRYPOINT ["limit-gate"]
